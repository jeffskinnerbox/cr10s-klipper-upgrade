#!/usr/bin/env bash
# sync-docs -- copy spec-kit masters to docs/ (docs/prd.md, docs/plan.md).
# specs/ is the source of truth; never edit the docs/ copies by hand.
# Usage: bin/sync-docs [FEATURE_DIR]   (default: from .specify/feature.json)
set -euo pipefail

root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
cd "$root"

feature="${1:-}"
if [[ -z "$feature" && -f .specify/feature.json ]]; then
  feature="$(sed -n 's/.*"feature_directory"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' .specify/feature.json)"
fi
# feature.json is git-ignored; fall back to the only feature on a fresh clone
feature="${feature:-specs/001-klipper-print-workflow}"
[[ -d "$feature" ]] || { echo "sync-docs: no feature dir '$feature'" >&2; exit 1; }

# Copy one file, add a header, and rewrite relative links so they resolve from docs/.
sync_one() {
  local src="$1" dst="$2"
  {
    printf '<!-- GENERATED by bin/sync-docs from %s. Do not edit; edit the source and re-run. -->\n\n' "$src"
    sed -E \
      -e 's#\]\(\.\./\.\./docs/#](#g' \
      -e "s#\]\((spec|plan|research|data-model|quickstart)\.md#](../${feature}/\1.md#g" \
      -e "s#\]\(contracts/#](../${feature}/contracts/#g" \
      -e "s#\]\(checklists/#](../${feature}/checklists/#g" \
      "$src"
  } > "$dst"
  echo "synced $src -> $dst"
}

sync_one "$feature/spec.md" docs/prd.md
sync_one "$feature/plan.md" docs/plan.md
